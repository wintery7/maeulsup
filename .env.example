# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 GitHub에 올리지 마세요.

# 공공데이터포털 (fetch.py) - 이미 받은 data/raw/maeulsup_raw.json 을 쓰면 없어도 됨
# photos.py 도 같은 키를 씀 (한국관광공사_국문 관광정보 서비스_GW 활용신청 필요)
DATA_GO_KR_KEY=
MAEULSUP_API_URL=https://apis.data.go.kr/1400000/cultureInfoService/오퍼레이션명

# 주소 -> 좌표 (geocode.py) - 둘 중 하나만 있으면 됨. 카카오가 주소 표기 차이에 더 너그러움
KAKAO_REST_KEY=
VWORLD_KEY=

# OpenAI (stories.py)
# 모델 이름은 자주 바뀌니 https://platform.openai.com/docs/models 에서 현재 권장 모델을 확인해서 넣으세요.
OPENAI_API_KEY=
OPENAI_MODEL=
# 사실 판정용. 비우면 OPENAI_MODEL 을 씀. 가능하면 생성용과 다른 모델을 쓰는 게 좋음
OPENAI_JUDGE_MODEL=

# Google Cloud Text-to-Speech (tts.py)
# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > API 키. Cloud Text-to-Speech API 사용 설정 필요
GOOGLE_TTS_API_KEY=
# 비워 두면 Chirp 3 HD (월 100만 자 무료, 말투 지시 없음). gemini-2.5-flash-tts 를 넣으면 Gemini-TTS (유료, Agent Platform API 사용 설정 필요)
GOOGLE_TTS_MODEL=
# 목소리 이름 (예: Sulafat, Achernar, Vindemiatrix, Kore, Charon)
GOOGLE_TTS_VOICE=Aoede
# 말 속도 (Chirp 3 HD 일 때만, 1.0 이 기본). 어린이용은 조금 천천히
GOOGLE_TTS_RATE_CHILD=0.9
GOOGLE_TTS_RATE_ADULT=1.0
# 말투 지시 (Gemini-TTS 일 때만 쓰임. Chirp 3 HD 에서는 무시됨)
GOOGLE_TTS_PROMPT_CHILD=어린아이에게 동화를 읽어 주듯 천천히, 다정하고 따뜻하게 읽어 주세요.
GOOGLE_TTS_PROMPT_ADULT=숲을 소개하는 해설사처럼 차분하고 또렷하게 읽어 주세요.
